    "id": "d_in_sens",
    "type": "mqtt in",
    "z": "tab_dashboard",
    "name": "Sensores",
    "topic": "invernadero/sensores/+",
    "qos": "1",
    "datatype": "utf8",
    "broker": "broker_mosquitto_dash",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
