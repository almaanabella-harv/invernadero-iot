    "type": "function",
    "z": "tab_dashboard",
    "name": "Texto actuadores",
    "func": "let act;\ntry { act = JSON.parse(msg.payload); } catch (e) { return null; }\nconst txt = e => e === 'ON' ? '🟢 Encendido' : '⚪ Apagado';\nreturn [{ payload: txt(act.riego) }, { payload: txt(act.ventilador) }];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
