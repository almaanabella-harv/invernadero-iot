  {
    "id": "d_fn_sep",
    "type": "function",
    "z": "tab_dashboard",
    "name": "Separar por sensor",
    "func": "const sensor = msg.topic.split('/').pop();\nconst valor = parseFloat(msg.payload);\nconst orden = { temperatura: 0, humedad_ambiente: 1, humedad_suelo: 2, luz: 3 };\nif (isNaN(valor) || !(sensor in orden)) return null;\n\nconst salida = [null, null, null, null, null];\nsalida[orden[sensor]] = { payload: valor };\nif (sensor === 'temperatura')   salida[4] = { topic: 'Temperatura (°C)', payload: valor };\nif (sensor === 'humedad_suelo') salida[4] = { topic: 'Humedad del suelo (%)', payload: valor };\nreturn salida;\n",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 320,
    "y": 100,
    "wires": [
      [
        "d_g_temp"
      ],
      [
        "d_g_ha"
      ],
      [
        "d_g_hs"
      ],
      [
        "d_g_luz"
      ],
      [
        "d_chart"
      ]
    ]
  },
